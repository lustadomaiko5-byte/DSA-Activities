#include <stdio.h>

int main() {
    int n = 5; // Size of the array based on the sample test cases
    int numbers[5];
    int sum = 0;
    float average;

    // Ask the user to enter values and store them in the array
    for (int i = 0; i < n; i++) {
        printf("Enter number %d: ", i + 1);
        scanf("%d", &numbers[i]);
    }

    printf("\n");

    // Display all values stored in the array
    printf("Numbers entered: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", numbers[i]);
        sum += numbers[i]; // Simultaneously calculate the sum while displaying/traversing
    }
    printf("\n");

    // Calculate the average
    average = (float)sum / n;

    // Display the sum and average
    printf("Sum is %d\n", sum);
    printf("Average is %.2f\n", average);

    return 0;
}
